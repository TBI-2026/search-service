OPENSEARCH_HOST=opensearch-node
OPENSEARCH_PORT=9200
OPENSEARCH_REPLICAS=0
OPENSEARCH_REFRESH_INTERVAL=1s
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FASTEMBED_CACHE_PATH=/app/.cache/fastembed
INDEX_API_KEY=
ROOT_PATH=
ENABLE_CONSUMER=true
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Accept,X-Index-Api-Key

REDIS_HOST=redis-search
REDIS_PORT=6379
EMBEDDING_CACHE_TTL=3600
RESULTS_CACHE_TTL=300

UVICORN_WORKERS=2

ENABLE_RERANKER=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=20

RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

DB_HOST=backend-database
DB_PORT=5432
DB_NAME=fondasikehidupan
DB_USERNAME=postgres
DB_PASSWORD=postgres
